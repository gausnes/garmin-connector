{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2025"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["src", "test"]
}
